### Register
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "full_name": "Test User",
  "email": "test@example.com",
  "password": "Test12345",
  "phone": "9876543210"
}

### Login
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Test12345"
}

### Get Current User
GET http://localhost:5000/api/auth/me


### Create Complaint with Image
POST http://localhost:5000/api/complaints
Content-Type: multipart/form-data; boundary=CivicLens

--CivicLens
Content-Disposition: form-data; name="title"

Large pothole
--CivicLens
Content-Disposition: form-data; name="description"

Dangerous pothole near road
--CivicLens
Content-Disposition: form-data; name="category"

pothole
--CivicLens
Content-Disposition: form-data; name="latitude"

20.2961
--CivicLens
Content-Disposition: form-data; name="longitude"

85.8245
--CivicLens
Content-Disposition: form-data; name="address"

Bhubaneswar
--CivicLens
Content-Disposition: form-data; name="images"; filename="pothole.jpg"
Content-Type: image/jpeg

< ./test-images/pothole.jpg
--CivicLens--

### Get My Complaints
GET http://localhost:5000/api/complaints/my

### Get Individual Complaint
GET http://localhost:5000/api/complaints/5d65b192-5a84-48d1-a664-fce3268c7aa2

### Update Complaint Status
PUT http://localhost:5000/api/complaints/5d65b192-5a84-48d1-a664-fce3268c7aa2/status
Content-Type: application/json

{
  "status": "under_review",
  "message": "Complaint verified by administration"
}

### Get Complaint with Status History
GET http://localhost:5000/api/complaints/5d65b192-5a84-48d1-a664-fce3268c7aa2